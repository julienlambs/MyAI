# Copier en .env (Windows) ou .env.linux (Linux) et renseigner tes propres
# valeurs (non versionné) — voir main.py pour le choix du fichier selon l'OS.

# Racine du projet MyAI et racine des projets accessibles depuis l'explorateur
WORKSPACE_ROOT=
PROJECTS_ROOT=

# Origines autorisées en CORS, séparées par des virgules (localhost + IP LAN +
# hostname(s) tailscale serve)
ALLOWED_ORIGINS=

# Timeout d'inactivité du stream qwen-code, en ms (0 = désactivé)
QWEN_STREAM_IDLE_TIMEOUT_MS=3600000

# Contact requis par la spec Web Push/VAPID (RFC 8292) pour les notifications
# push — un mailto: ou une URL
VAPID_CONTACT=mailto:admin@example.com
